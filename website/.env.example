# EduXFair website. Only the /delete-account/ page talks to Supabase.
# Copy to .env.local (dev) or .env.production (build) and fill in.
# Never commit the filled-in file.
#
# The anon key is safe in a browser bundle: RLS protects the data, and the
# delete-account function only ever deletes the signed-in caller. The
# service-role key must NEVER appear here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# Lekkside Connect web console.
# Copy to .env.local and fill in. Never commit the filled-in file.
#
# The anon key is safe in a browser bundle: RLS protects the data. The
# service-role key must NEVER appear here — it bypasses RLS entirely.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

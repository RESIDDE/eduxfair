# Lekkside Connect — environment template.
# Copy to .env (Flutter) / web/.env.local (React) and fill in. Never commit the real files.

# ---------------------------------------------------------------- Supabase
# Project settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=

# Server-side only: used by Edge Functions and the CLI. Bypasses RLS entirely,
# so it must never reach a client bundle or a Flutter asset.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------- email
# Transactional email for domain verification and notifications (resend.com).
RESEND_API_KEY=
RESEND_FROM=Lekkside Connect <no-reply@lekkside.com>

# Where email links should point.
APP_URL=https://connect.lekkside.com

# ----------------------------------------------------------------- LiveKit
# In-app video for Live Spaces and 1:1 appointments. Server-side only: the
# clients never hold these, because the `livekit-token` function returns the
# URL alongside the token it signs.
LIVEKIT_URL=wss://meet.lekksideexpo.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

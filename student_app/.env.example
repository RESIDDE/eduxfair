# Local development config for the Lekkside Connect student app.
# Copy from ../.env.example and fill in. Never commit the filled-in file.
#
# The anon key is safe to ship in a client: RLS is what protects the data. The
# service-role key must NEVER appear here — it bypasses RLS entirely.
SUPABASE_URL=
SUPABASE_ANON_KEY=
